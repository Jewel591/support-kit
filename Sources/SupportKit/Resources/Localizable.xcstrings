    "We will get back to you soon. Follow us on Xiaohongshu to see fixes and updates first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir melden uns bald bei dir. Folge uns auf Xiaohongshu, um zuerst von Fehlerbehebungen und Updates zu erfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos pondremos en contacto contigo pronto. Síguenos en Xiaohongshu para enterarte antes que nadie de las correcciones y novedades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous répondrons bientôt. Suivez-nous sur Xiaohongshu pour découvrir en avant-première les correctifs et les nouveautés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近日中にご連絡します。小紅書をフォローして、修正やアップデートの最新情報をいち早くご覧ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곧 답변드리겠습니다. 샤오홍슈를 팔로우하고 수정 사항과 업데이트 소식을 가장 먼저 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retornaremos em breve. Siga-nos no Xiaohongshu para saber primeiro sobre correções e novidades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会尽快回复你。关注我们的小红书，第一时间了解问题修复和更新动态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會盡快回覆你。關注我們的小紅書，第一時間掌握問題修正與更新動態。"
          }
        }
      }
    },
