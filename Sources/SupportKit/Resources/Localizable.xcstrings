    "App Version:" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "App-Version:" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Versión de la app:" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Version de l’app :" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Appのバージョン:" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 버전:" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Versão do app:" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 版本：" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 版本：" } }
      }
    },
    "We regularly read and respond to App Store reviews. Email is best for details and device diagnostics." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wir lesen und beantworten regelmäßig App-Store-Rezensionen. Für Details und Gerätediagnosen ist E-Mail am besten geeignet." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisamos periódicamente las reseñas del App Store y respondemos a ellas. El correo es la mejor opción para enviar detalles y diagnósticos del dispositivo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nous consultons régulièrement les avis sur l’App Store et y répondons. L’e-mail est préférable pour partager des détails et des diagnostics de l’appareil." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "App Storeのレビューを定期的に確認し、返信しています。詳しい内容やデバイスの診断情報をお送りいただく場合は、メールが適しています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "App Store 리뷰를 정기적으로 확인하고 답변드리고 있습니다. 자세한 내용과 기기 진단 정보를 보내실 때는 이메일이 가장 적합합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lemos regularmente as avaliações na App Store e respondemos a elas. O e-mail é a melhor opção para enviar detalhes e diagnósticos do dispositivo." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我们会定期查看并回复 App Store 评论。若要提供详细信息和设备诊断，使用邮件更合适。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我們會定期查看並回覆 App Store 評論。若要提供詳細資訊和裝置診斷，使用電郵較合適。" } }
      }
    },
